{
    "publisher": "billti",
    "name": "vsmin",
    "version": "0.1.0",
    "displayName": "Minimal VS Code extension",
    "type": "commonjs",
    "engines": {
        "vscode": "^1.95.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "browser": "./extension.js",
    "virtualWorkspaces": true,
    "contributes": {
        "commands": [
            {
                "command": "vsmin.cmd",
                "title": "VS Min Command"
            }
        ],
        "customEditors": [
            {
                "viewType": "vsmin.circuitEditor",
                "displayName": "Circuit",
                "selector": [
                    {
                        "filenamePattern": "circuit.json"
                    }
                ]
            }
        ]
    },
    "license": "MIT",
    "devDependencies": {
        "@types/vscode": "^1.95.0"
    },
    "scripts": {
        "start": "http-server"
    }
}
